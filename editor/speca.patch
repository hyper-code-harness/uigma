diff --git a/packages/core/src/editor/connectors/quick-create.ts b/packages/core/src/editor/connectors/quick-create.ts
new file mode 100644
index 0000000..eb72c82
--- /dev/null
+++ b/packages/core/src/editor/connectors/quick-create.ts
@@ -0,0 +1,253 @@
+import type { SceneGraph, SceneNode } from '@open-pencil/scene-graph'
+import { boundEndpoint, createConnector } from '@open-pencil/scene-graph/connectors'
+import {
+  getAbsolutePosition,
+  getAxisAlignedWorldBounds,
+  getParentWorldMatrix
+} from '@open-pencil/scene-graph/coordinate'
+import { generatedFrameOwner, generatedFrameText } from '@open-pencil/scene-graph/generated'
+import Matrix from '@open-pencil/scene-graph/matrix'
+import type { Rect, Vector } from '@open-pencil/scene-graph/primitives'
+
+import { duplicateNode } from '#core/editor/clipboard'
+import type { EditorContext, EditorState } from '#core/editor/types'
+import { pushCreatedSubtreesUndo } from '#core/editor/undo'
+import { resolveEditorProfile } from '#core/editor/views/profile'
+import type { EditorProfileInputs } from '#core/editor/views/types'
+
+/**
+ * Quick create, as FigJam's: a selected block on a board shows a dot off each of its sides; a click
+ * on one puts a copy of the block that way, joined to it by a connector, and a drag from one draws
+ * a connector from that side.
+ */
+
+export type QuickCreateSide = 'TOP' | 'RIGHT' | 'BOTTOM' | 'LEFT'
+
+export const QUICK_CREATE_SIDES: readonly QuickCreateSide[] = ['TOP', 'RIGHT', 'BOTTOM', 'LEFT']
+
+/** How far off a side its dot sits, and how close a pointer takes it, in screen pixels. */
+export const QUICK_CREATE_DOT_OFFSET = 20
+export const QUICK_CREATE_HIT_RADIUS = 12
+/** A block smaller than this on screen shows no dots: they would sit on one another. */
+const QUICK_CREATE_MIN_SCREEN_SIZE = 28
+/** The space left between a block and the one made from it, and between two made the same way. */
+const QUICK_CREATE_GAP = 96
+const QUICK_CREATE_STACK_GAP = 40
+const MAX_PLACES_TRIED = 60
+
+/** Layers that are not blocks of a diagram: lines, containers of blocks, and bare text. */
+const NOT_BLOCKS: ReadonlySet<SceneNode['type']> = new Set([
+  'CONNECTOR',
+  'SECTION',
+  'LINE',
+  'TEXT',
+  'CANVAS',
+  'DOCUMENT'
+] as Array<SceneNode['type']>)
+
+const OUTWARD: Record<QuickCreateSide, Vector> = {
+  TOP: { x: 0, y: -1 },
+  RIGHT: { x: 1, y: 0 },
+  BOTTOM: { x: 0, y: 1 },
+  LEFT: { x: -1, y: 0 }
+}
+
+type QuickCreateState = EditorProfileInputs &
+  Pick<EditorState, 'activeTool' | 'selectedIds' | 'nodeEditState' | 'penState' | 'zoom'>
+
+function lockedInTree(graph: SceneGraph, node: SceneNode): boolean {
+  return graph.closest(node.id, (ancestor) => ancestor.locked) !== undefined
+}
+
+/** The block quick create starts from: the only selected layer of a board, when it is a block. */
+export function quickCreateSource(graph: SceneGraph, state: QuickCreateState): SceneNode | null {
+  if (state.documentKind !== 'board' || state.activeTool !== 'SELECT') return null
+  if (state.selectedIds.size !== 1 || state.nodeEditState || state.penState) return null
+  if (resolveEditorProfile(state).layerEdits !== 'all') return null
+  const [id] = state.selectedIds
+  const node = graph.getNode(id)
+  if (!node || NOT_BLOCKS.has(node.type) || !node.visible) return null
+  if (lockedInTree(graph, node) || generatedFrameOwner(graph, node)) return null
+  const parent = node.parentId ? graph.getNode(node.parentId) : undefined
+  // A block in an auto layout sits where the layout puts it, so there is no side to grow from.
+  if (!parent || (parent.layoutMode !== 'NONE' && node.layoutPositioning !== 'ABSOLUTE')) return null
+  const box = getAxisAlignedWorldBounds(node, graph)
+  if (Math.min(box.width, box.height) * state.zoom < QUICK_CREATE_MIN_SCREEN_SIZE) return null
+  return node
+}
+
+/** What the canvas draws of quick create: the block with dots, and the dot under the pointer. */
+export function quickCreateOverlay(
+  graph: SceneGraph,
+  state: QuickCreateState & Pick<EditorState, 'quickCreateHover'>
+): { nodeId: string; hover: QuickCreateSide | null } | null {
+  const node = quickCreateSource(graph, state)
+  return node ? { nodeId: node.id, hover: state.quickCreateHover } : null
+}
+
+/** Where each side's dot sits, in page coordinates, at `zoom`. */
+export function quickCreateDots(
+  graph: SceneGraph,
+  node: SceneNode,
+  zoom: number
+): Array<{ side: QuickCreateSide; x: number; y: number }> {
+  const box = getAxisAlignedWorldBounds(node, graph)
+  const cx = box.x + box.width / 2
+  const cy = box.y + box.height / 2
+  const off = QUICK_CREATE_DOT_OFFSET / zoom
+  return [
+    { side: 'TOP', x: cx, y: box.y - off },
+    { side: 'RIGHT', x: box.x + box.width + off, y: cy },
+    { side: 'BOTTOM', x: cx, y: box.y + box.height + off },
+    { side: 'LEFT', x: box.x - off, y: cy }
+  ]
+}
+
+function intersects(a: Rect, b: Rect): boolean {
+  return (
+    a.x < b.x + b.width && b.x < a.x + a.width && a.y < b.y + b.height && b.y < a.y + a.height
+  )
+}
+
+function contains(outer: Rect, inner: Rect): boolean {
+  return (
+    inner.x >= outer.x &&
+    inner.y >= outer.y &&
+    inner.x + inner.width <= outer.x + outer.width &&
+    inner.y + inner.height <= outer.y + outer.height
+  )
+}
+
+/** The boxes a new block must not cover: every block of the page, inside its sections too. */
+function blocksOfPage(graph: SceneGraph, pageId: string, source: SceneNode): Rect[] {
+  const boxes: Rect[] = []
+  const walk = (parentId: string) => {
+    for (const child of graph.getChildren(parentId)) {
+      if (child.type === 'CONNECTOR' || !child.visible) continue
+      // A section, or whatever holds the source, is where blocks sit, not one of them.
+      const holdsBlocks =
+        child.type === 'SECTION' || (child.id !== source.id && graph.isDescendant(source.id, child.id))
+      if (holdsBlocks) {
+        walk(child.id)
+        continue
+      }
+      boxes.push(getAxisAlignedWorldBounds(child, graph))
+    }
+  }
+  walk(pageId)
+  return boxes
+}
+
+/**
+ * Where the block made from `node` on `side` goes, in page coordinates: a gap away that way, and
+ * past the blocks already there, as FigJam fans out the second and third block made from a side.
+ */
+export function quickCreatePlace(graph: SceneGraph, node: SceneNode, side: QuickCreateSide): Rect {
+  const from = getAxisAlignedWorldBounds(node, graph)
+  const out = OUTWARD[side]
+  const place = {
+    x: from.x + out.x * (from.width + QUICK_CREATE_GAP),
+    y: from.y + out.y * (from.height + QUICK_CREATE_GAP),
+    width: from.width,
+    height: from.height
+  }
+  const pageId = graph.pageOf(node.id)
+  if (!pageId) return place
+  const taken = blocksOfPage(graph, pageId, node)
+  // Blocks made to the left or right stack downwards; ones made above or below stack rightwards.
+  const step =
+    out.x !== 0
+      ? { x: 0, y: from.height + QUICK_CREATE_STACK_GAP }
+      : { x: from.width + QUICK_CREATE_STACK_GAP, y: 0 }
+  for (let tries = 0; tries < MAX_PLACES_TRIED; tries++) {
+    if (!taken.some((box) => intersects(box, place))) break
+    place.x += step.x
+    place.y += step.y
+  }
+  return place
+}
+
+/** The container the new block goes into: the nearest one around the source that holds `place`. */
+function parentHolding(graph: SceneGraph, node: SceneNode, place: Rect, pageId: string): string {
+  let parentId = node.parentId
+  while (parentId && parentId !== pageId) {
+    const parent = graph.getNode(parentId)
+    if (!parent) break
+    if (contains(getAxisAlignedWorldBounds(parent, graph), place)) return parent.id
+    parentId = parent.parentId
+  }
+  return pageId
+}
+
+export function createQuickCreateActions(ctx: EditorContext) {
+  function quickCreateNode(): SceneNode | null {
+    return quickCreateSource(ctx.graph, ctx.state)
+  }
+
+  /** The side whose dot is under the point, in page coordinates. */
+  function quickCreateSideAt(x: number, y: number): QuickCreateSide | null {
+    const node = quickCreateNode()
+    if (!node) return null
+    const reach = QUICK_CREATE_HIT_RADIUS / ctx.state.zoom
+    const dot = quickCreateDots(ctx.graph, node, ctx.state.zoom).find(
+      (candidate) => Math.hypot(candidate.x - x, candidate.y - y) <= reach
+    )
+    return dot?.side ?? null
+  }
+
+  function setQuickCreateHover(side: QuickCreateSide | null) {
+    if (ctx.state.quickCreateHover === side) return
+    ctx.state.quickCreateHover = side
+    ctx.requestRepaint()
+  }
+
+  /**
+   * Puts a copy of the selected block on `side` of it, joined to it by a connector, and selects
+   * the copy: one undo step. A sticky note or a shape starts empty, as a new one; the text layer
+   * to type into is returned with it, and the box the copy took, in page coordinates.
+   */
+  function quickCreateFrom(
+    side: QuickCreateSide
+  ): { node: SceneNode; text: SceneNode | null; place: Rect } | null {
+    const source = quickCreateNode()
+    const graph = ctx.graph
+    const pageId = source ? graph.pageOf(source.id) : null
+    if (!source || !pageId) return null
+    const previousSelection = new Set(ctx.state.selectedIds)
+    const from = getAxisAlignedWorldBounds(source, graph)
+    const place = quickCreatePlace(graph, source, side)
+    const parentId = parentHolding(graph, source, place, pageId)
+    // The copy keeps the source's turn and size, so its origin moves as its box does.
+    const origin = getAbsolutePosition(source, graph)
+    const toParent =
+      Matrix.invert(getParentWorldMatrix(graph.getNode(parentId), graph)) ?? Matrix.identity()
+    const [x, y] = Matrix.mapPoints(toParent, [
+      origin.x + place.x - from.x,
+      origin.y + place.y - from.y
+    ])
+    const copy = duplicateNode(ctx, source, parentId, { x: Math.round(x), y: Math.round(y) })
+    if (!copy) return null
+    const text = generatedFrameText(graph, copy) ?? null
+    if (text) graph.updateNode(text.id, { text: '', styleRuns: [], textParagraphs: [] })
+    ctx.runLayoutForNode(copy.id)
+    const connector = createConnector(graph, pageId, {
+      start: boundEndpoint(source.id),
+      end: boundEndpoint(copy.id),
+      startCap: 'NONE',
+      endCap: 'ARROW_LINES'
+    })
+    ctx.runLayoutForNode(connector.id)
+
+    pushCreatedSubtreesUndo(ctx, 'Add connected block', [copy.id, connector.id], previousSelection)
+    ctx.state.quickCreateHover = null
+    ctx.setSelectedIds(new Set([copy.id]))
+    ctx.requestRender()
+    return {
+      node: graph.getNode(copy.id) ?? copy,
+      text: text ? (graph.getNode(text.id) ?? text) : null,
+      place
+    }
+  }
+
+  return { quickCreateNode, quickCreateSideAt, setQuickCreateHover, quickCreateFrom }
+}
