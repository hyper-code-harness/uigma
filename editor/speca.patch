@@ -0,0 +1,79 @@
+import { resolveEditorProfile, type Editor } from '@open-pencil/core'
+
+import type { DragConnectorDraw, DragState } from '#vue/shared/input/types'
+
+/**
+ * The quick-create dot under the pointer, shown as hovered; none where layers are not edited. The
+ * select tool asks before its other handles, so a dot takes the pointer where it shows.
+ */
+export function hoverQuickCreate(editor: Editor, cx: number, cy: number): boolean {
+  if (resolveEditorProfile(editor.state).layerEdits !== 'all') return false
+  const side = editor.quickCreateSideAt(cx, cy)
+  editor.setQuickCreateHover(side)
+  return side !== null
+}
+
+/** The room kept between a new block and the edge of the canvas, in screen pixels. */
+const VIEW_MARGIN = 64
+
+/** Pans just as far as the new block needs to be on screen, so a chain grows past the edge. */
+function bringIntoView(editor: Editor, place: { x: number; y: number; width: number; height: number }) {
+  const { width, height } = editor.getViewportSize()
+  const { zoom, panX, panY } = editor.state
+  const left = place.x * zoom + panX
+  const top = place.y * zoom + panY
+  const right = left + place.width * zoom
+  const bottom = top + place.height * zoom
+  const shift = (start: number, end: number, size: number) => {
+    if (end - start > size - VIEW_MARGIN * 2) return 0
+    if (start < VIEW_MARGIN) return VIEW_MARGIN - start
+    return end > size - VIEW_MARGIN ? size - VIEW_MARGIN - end : 0
+  }
+  const dx = shift(left, right, width)
+  const dy = shift(top, bottom, height)
+  if (dx !== 0 || dy !== 0) editor.pan(dx, dy)
+}
+
+/**
+ * A press on a quick-create dot, as FigJam takes it: a click puts a block that way, joined by a
+ * connector, and starts typing in it; a drag draws a connector from that side of the block.
+ */
+export function tryStartQuickCreate(
+  editor: Editor,
+  cx: number,
+  cy: number,
+  sx: number,
+  sy: number,
+  setDrag: (drag: DragState) => void
+): boolean {
+  const side = editor.quickCreateSideAt(cx, cy)
+  const source = side ? editor.quickCreateNode() : null
+  if (!side || !source) return false
+  editor.setQuickCreateHover(null)
+  editor.connectorBeginFrom(source.id, side)
+  const drag: DragConnectorDraw = {
+    type: 'connector-draw',
+    startSX: sx,
+    startSY: sy,
+    moved: false,
+    x: cx,
+    y: cy,
+    modifiers: {},
+    commit: () => {
+      if (drag.moved) {
+        // The select tool keeps what was just drawn in hand, to label it or take it back.
+        const connectorId = editor.connectorRelease(drag.x, drag.y, true, drag.modifiers)
+        if (connectorId) editor.select([connectorId])
+        return
+      }
+      editor.connectorCancel()
+      const made = editor.quickCreateFrom(side)
+      if (!made) return
+      bringIntoView(editor, made.place)
+      if (made.text) editor.startTextEditing(made.text.id)
+    },
+    cancel: () => editor.connectorCancel()
+  }
+  setDrag(drag)
+  return true
+}
