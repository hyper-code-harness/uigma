diff --git a/src/app/host/bridge.ts b/src/app/host/bridge.ts
new file mode 100644
index 0000000..1522fd1
--- /dev/null
+++ b/src/app/host/bridge.ts
@@ -0,0 +1,323 @@
+/**
+ * The hosted editor's line to the page that frames it (see `./flags`). The host keeps the document:
+ * it sends the file once the editor says it is ready, takes a copy after each run of edits, and
+ * relays its agent's requests to the same handler an MCP client's calls reach. Messages travel by
+ * `postMessage`; only the framing window is listened to, and the document is posted only to the
+ * origin that sent it in.
+ *
+ *   host → editor   { uigma: 'init', doc, name, type, canEdit, theme }
+ *                   { uigma: 'call', id, command, args } · { uigma: 'cancel', id }
+ *                     (`reveal` { ids } is the bridge's own command: select layers and show them)
+ *                   { uigma: 'flush' } · { uigma: 'theme', theme }
+ *   editor → host   { uigma: 'ready', version } · { uigma: 'loaded', summary }
+ *                   { uigma: 'dirty' } · { uigma: 'clean' } · { uigma: 'save', seq, bytes, summary }
+ *                   { uigma: 'result', id, ok, result | error } · { uigma: 'failed', error }
+ *                   { uigma: 'paste-pages', tab, parts }
+ */
+// eslint-disable-next-line open-pencil/no-mixed-case-acronym-identifiers -- Upstream export spelling.
+import { toJsonSchema as toJSONSchema } from '@valibot/to-json-schema'
+
+import { ALL_TOOLS, isToolExposed } from '@open-pencil/core/tools'
+
+import { makeFigmaFromStore } from '@/app/automation/bridge/figma-factory'
+import { createAutomationCommandHandlers } from '@/app/automation/bridge/handlers'
+import type { EditorStore } from '@/app/editor/session/create'
+import { APP_VERSION } from '@/app/runtime/version'
+import { setAppTheme } from '@/app/shell/theme'
+import { getActiveStore, openFileInNewTab } from '@/app/tabs'
+
+import { HOSTED, hostedActions } from './flags'
+
+/** How long edits must pause before a copy goes to the host, and the longest a copy waits. */
+const QUIET_MS = 1500
+const MAX_WAIT_MS = 15_000
+
+/** The requests a host's agent may send: work on the document, never files, tabs, or settings. */
+const HOST_COMMANDS = new Set([
+  'tool',
+  'eval',
+  'export',
+  'export_jsx',
+  'selection',
+  'undo',
+  'redo'
+])
+
+const CONTENT_EVENTS = [
+  'node:created',
+  'node:updated',
+  'node:deleted',
+  'node:reparented',
+  'node:reordered',
+  'graph:replaced',
+  'history:changed'
+] as const
+
+interface HostInit {
+  doc?: ArrayBuffer | null
+  name?: string
+  type?: 'design' | 'board'
+  canEdit?: boolean
+  theme?: string
+}
+
+let hostOrigin: string | null = null
+let documentStore: EditorStore | null = null
+let editable = false
+let sequence = 0
+let timer: ReturnType<typeof setTimeout> | undefined
+let firstChangeAt = 0
+let announced = false
+let saving = false
+let again = false
+const running = new Map<string, AbortController>()
+
+function post(message: Record<string, unknown>, transfer: Transferable[] = []): void {
+  // Before the host has spoken only `ready` goes out, which says nothing about a document.
+  window.parent.postMessage(message, hostOrigin ?? '*', transfer)
+}
+
+/**
+ * A paste of pages copied on another of the host's canvases: the clipboard carries only their
+ * address (`data-speca-pages`), and the host brings them in as layers. True when the paste is its.
+ */
+function offerPages(html: string): boolean {
+  if (!HOSTED || !documentStore || !editable || !html.includes('data-speca-pages')) return false
+  const mark = new DOMParser()
+    .parseFromString(html, 'text/html')
+    .querySelector('[data-speca-pages]')
+    ?.getAttribute('data-speca-pages')
+  if (!mark) return false
+  let address: unknown
+  try {
+    address = JSON.parse(mark)
+  } catch {
+    return false
+  }
+  if (typeof address !== 'object' || address === null) return false
+  const { tab, parts } = address as { tab?: unknown; parts?: unknown }
+  if (typeof tab !== 'string' || !Array.isArray(parts) || !parts.length) return false
+  if (!parts.every((part) => typeof part === 'string')) return false
+  post({ uigma: 'paste-pages', tab, parts })
+  return true
+}
+
+function describe(error: unknown): string {
+  return error instanceof Error ? error.message : String(error)
+}
+
+function summarize(store: EditorStore) {
+  return {
+    pages: store.graph.getPages().map((page) => ({
+      id: page.id,
+      name: page.name,
+      layers: store.graph.countDescendants(page.id)
+    }))
+  }
+}
+
+function applyTheme(theme: unknown): void {
+  if (theme === 'dark' || theme === 'light') setAppTheme(theme)
+}
+
+/** The tools an agent may call, with their inputs, for the host to describe to its agent. */
+function describeTools() {
+  return ALL_TOOLS.filter((tool) => isToolExposed(tool, 'mcp')).map((tool) => ({
+    name: tool.name,
+    description: tool.description,
+    mutates: tool.mutates,
+    inputSchema: toJSONSchema(tool.input, { typeMode: 'input', errorMode: 'ignore' })
+  }))
+}
+
+function changed(): void {
+  if (!documentStore || !editable) return
+  if (!announced) {
+    announced = true
+    post({ uigma: 'dirty' })
+  }
+  const now = Date.now()
+  firstChangeAt ||= now
+  clearTimeout(timer)
+  timer = setTimeout(
+    () => void flush(),
+    Math.max(0, Math.min(QUIET_MS, firstChangeAt + MAX_WAIT_MS - now))
+  )
+}
+
+/** Hands the host a copy of the document as it is now, if it changed since the last one. */
+export async function flush(): Promise<void> {
+  clearTimeout(timer)
+  timer = undefined
+  const store = documentStore
+  if (!store || !editable) return
+  if (saving) {
+    again = true
+    return
+  }
+  firstChangeAt = 0
+  announced = false
+  if (!store.hasUnsavedChanges()) {
+    post({ uigma: 'clean' })
+    return
+  }
+  saving = true
+  try {
+    await store.saveFigFileCopy(async (data) => {
+      const bytes = new Uint8Array(data.byteLength)
+      bytes.set(data)
+      post({ uigma: 'save', seq: ++sequence, bytes: bytes.buffer, summary: summarize(store) }, [
+        bytes.buffer
+      ])
+    })
+  } catch (error) {
+    console.error('[Host] Could not hand the document over:', error)
+    post({ uigma: 'failed', saving: true, error: describe(error) })
+    again = true
+  } finally {
+    saving = false
+    if (again) {
+      again = false
+      changed()
+    }
+  }
+}
+
+async function open(init: HostInit): Promise<void> {
+  if (documentStore) return
+  try {
+    applyTheme(init.theme)
+    const name = init.name?.trim() || 'Untitled'
+    let store: EditorStore
+    if (init.doc && init.doc.byteLength > 0) {
+      const extension = init.type === 'board' ? 'jam' : 'fig'
+      store = await openFileInNewTab(
+        new File([init.doc], `${name}.${extension}`, { type: 'application/octet-stream' })
+      )
+    } else {
+      store = getActiveStore()
+      store.state.documentName = name
+    }
+    editable = init.canEdit === true
+    store.setReadOnly(!editable)
+    documentStore = store
+    for (const event of CONTENT_EVENTS) store.onEditorEvent(event, changed)
+    post({ uigma: 'loaded', summary: summarize(store) })
+  } catch (error) {
+    console.error('[Host] Could not open the document:', error)
+    post({ uigma: 'failed', error: describe(error) })
+  }
+}
+
+const automation = createAutomationCommandHandlers(makeFigmaFromStore)
+
+/**
+ * A result a window cannot be sent as it is (one holding a reactive object of the editor, as the
+ * viewport's) goes as its JSON.
+ */
+function postResult(id: string, result: unknown): void {
+  try {
+    post({ uigma: 'result', id, ok: true, result })
+  } catch (error) {
+    if (!(error instanceof DOMException) || error.name !== 'DataCloneError') throw error
+    post({ uigma: 'result', id, ok: true, result: JSON.parse(JSON.stringify(result)) })
+  }
+}
+
+/**
+ * Selects layers of the page on screen and brings them into view: what the person sees after a
+ * paste the host carried out for them. Layers of other pages, or gone meanwhile, are left alone.
+ */
+function reveal(store: EditorStore, args: unknown): number {
+  const named = (args as { ids?: unknown } | null)?.ids
+  const onScreen = (id: string): boolean => {
+    for (let node = store.graph.getNode(id); node; node = store.graph.getNode(node.parentId ?? '')) {
+      if (node.id === store.state.currentPageId) return true
+    }
+    return false
+  }
+  const ids = (Array.isArray(named) ? named : []).filter(
+    (id): id is string => typeof id === 'string' && onScreen(id)
+  )
+  if (ids.length === 0) return 0
+  store.select(ids)
+  store.zoomToSelection()
+  return ids.length
+}
+
+async function call(id: string, command: string, args: unknown): Promise<void> {
+  const abort = new AbortController()
+  running.set(id, abort)
+  try {
+    const store = documentStore
+    if (!store) throw new Error('The document is still opening')
+    let result: unknown
+    if (command === 'tools') result = { ok: true, result: describeTools() }
+    else if (command === 'summary') result = { ok: true, result: summarize(store) }
+    else if (command === 'reveal') result = { ok: true, result: { shown: reveal(store, args) } }
+    else if (!HOST_COMMANDS.has(command)) throw new Error(`Unknown command: ${command}`)
+    else if (!editable) throw new Error('This document is open for viewing only')
+    else result = await automation.handleRequest(store, command, args, abort.signal)
+    postResult(id, result)
+  } catch (error) {
+    post({ uigma: 'result', id, ok: false, error: describe(error) })
+  } finally {
+    running.delete(id)
+  }
+}
+
+function receive(event: MessageEvent): void {
+  if (event.source !== window.parent) return
+  const message = event.data as Record<string, unknown> | null
+  if (!message || typeof message !== 'object' || typeof message.uigma !== 'string') return
+  hostOrigin ??= event.origin
+  if (event.origin !== hostOrigin) return
+  switch (message.uigma) {
+    case 'init':
+      void open(message as HostInit)
+      break
+    case 'call':
+      if (typeof message.id === 'string' && typeof message.command === 'string') {
+        void call(message.id, message.command, message.args)
+      }
+      break
+    case 'cancel':
+      if (typeof message.id === 'string') running.get(message.id)?.abort()
+      break
+    case 'flush':
+      void flush()
+      break
+    case 'theme':
+      applyTheme(message.theme)
+      break
+  }
+}
+
+/**
+ * Starts listening to the host and tells it the editor is up. The pointer or the focus leaving the
+ * frame, or the page going away, hands over what is not yet with the host: the host may drop the
+ * frame next (the person is on their way to another of its tabs).
+ */
+export function startHostBridge(): () => void {
+  if (!HOSTED) return () => undefined
+  const leaving = () => void flush()
+  const hidden = () => {
+    if (document.visibilityState === 'hidden') void flush()
+  }
+  hostedActions.save = leaving
+  hostedActions.paste = offerPages
+  window.addEventListener('message', receive)
+  window.addEventListener('blur', leaving)
+  window.addEventListener('pagehide', leaving)
+  document.documentElement.addEventListener('mouseleave', leaving)
+  document.addEventListener('visibilitychange', hidden)
+  post({ uigma: 'ready', version: APP_VERSION })
+  return () => {
+    window.removeEventListener('message', receive)
+    window.removeEventListener('blur', leaving)
+    window.removeEventListener('pagehide', leaving)
+    document.documentElement.removeEventListener('mouseleave', leaving)
+    document.removeEventListener('visibilitychange', hidden)
+    clearTimeout(timer)
+  }
+}
diff --git a/src/app/host/flags.ts b/src/app/host/flags.ts
new file mode 100644
index 0000000..400783a
--- /dev/null
+++ b/src/app/host/flags.ts
@@ -0,0 +1,55 @@
+/**
+ * Hosted mode: the editor runs in a frame of another app's page (Speca's Uigma canvas), which keeps
+ * the document itself. The host hands the file in, takes every save, and passes its agent's
+ * requests (see `./bridge`). `?speca=1` in the address turns it on; nothing here imports the app,
+ * so the entry module can read it before the bundle loads.
+ */
+const params = new URLSearchParams(typeof location === 'undefined' ? '' : location.search)
+
+export const HOSTED =
+  typeof window !== 'undefined' && window.parent !== window && params.has('speca')
+
+/** The kind of document a tab without a file of its own starts as. */
+export const HOSTED_DOCUMENT_KIND: 'design' | 'board' =
+  params.get('type') === 'board' ? 'board' : 'design'
+
+/**
+ * What the host's frame changes in the app: Save hands the document over now, and a paste is first
+ * offered to the host (true when it took it). The bridge sets both once it runs.
+ */
+export const hostedActions: { save: () => void; paste: (html: string) => boolean } = {
+  save: () => undefined,
+  paste: () => false
+}
+
+function put(key: string, value: string, always = false): void {
+  try {
+    if (always || localStorage.getItem(key) === null) localStorage.setItem(key, value)
+  } catch {
+    // Storage the frame may not use: the editor then starts with its own defaults.
+  }
+}
+
+/**
+ * What the host decides before the app reads its settings: its language and theme, whether fonts
+ * may come from the internet, and that nothing greets the person or keeps copies on its own — the
+ * host has the file. Preferences are written once, so the person's later choices stay.
+ */
+export function prepareHostedPreferences(): void {
+  if (!HOSTED) return
+  const lang = params.get('lang')
+  if (lang) put('open-pencil-locale', lang, true)
+  const theme = params.get('theme')
+  if (theme === 'dark' || theme === 'light') put('open-pencil:theme', theme, true)
+  put('op-online-fonts-enabled', params.get('fonts') === '1' ? 'true' : 'false', true)
+  put(
+    'open-pencil:preferences:v1',
+    JSON.stringify({
+      version: 1,
+      onboarding: { aiSetup: 'done' },
+      recovery: { enabled: false },
+      sharing: { dailyPing: false, usageStats: 'denied' },
+      updates: { checkOnStartup: false }
+    })
+  )
+}
