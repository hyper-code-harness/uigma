index 0000000..a59499e
--- /dev/null
+++ b/packages/core/src/canvas/overlays/quick-create.ts
@@ -0,0 +1,93 @@
+import type { Canvas } from '@open-pencil/canvaskit'
+import type { SceneGraph } from '@open-pencil/scene-graph'
+import { getAxisAlignedWorldBounds } from '@open-pencil/scene-graph/coordinate'
+import type { Rect, Vector } from '@open-pencil/scene-graph/primitives'
+
+import type { RenderOverlays, SkiaRenderer } from '#core/canvas/renderer'
+import { quickCreateDots, quickCreatePlace } from '#core/editor/connectors/quick-create'
+
+import { dashEffect } from './outline'
+
+/** A dot at rest, and the one under the pointer with its plus, in screen pixels. */
+const DOT_RADIUS = 4.5
+const HOVERED_DOT_RADIUS = 11
+const PLUS_ARM = 5
+const GHOST_RADIUS = 6
+const GHOST_ALPHA = 0.55
+const GHOST_FILL_ALPHA = 0.06
+
+function toScreen(r: SkiaRenderer, point: Vector): Vector {
+  return { x: point.x * r.zoom + r.panX, y: point.y * r.zoom + r.panY }
+}
+
+/** Where the new block would go and the line that would join it, shown before the click. */
+function drawGhost(r: SkiaRenderer, canvas: Canvas, from: Rect, place: Rect) {
+  const topLeft = toScreen(r, place)
+  const rect = r.ck.XYWHRect(topLeft.x, topLeft.y, place.width * r.zoom, place.height * r.zoom)
+  const rounded = r.ck.RRectXY(rect, GHOST_RADIUS, GHOST_RADIUS)
+  r.auxFill.setMaskFilter(null)
+  r.auxFill.setColor(r.selColor(GHOST_FILL_ALPHA))
+  canvas.drawRRect(rounded, r.auxFill)
+  r.auxStroke.setStrokeWidth(1.5)
+  r.auxStroke.setColor(r.selColor(GHOST_ALPHA))
+  r.auxStroke.setPathEffect(dashEffect(r, 5, 4))
+  canvas.drawRRect(rounded, r.auxStroke)
+  // The line leaves the middle of the block's box and stops at the new one's, clipped to the gap
+  // between them along the axis they are apart on.
+  const a = toScreen(r, { x: from.x + from.width / 2, y: from.y + from.height / 2 })
+  const b = toScreen(r, { x: place.x + place.width / 2, y: place.y + place.height / 2 })
+  const halfA = { x: (from.width * r.zoom) / 2, y: (from.height * r.zoom) / 2 }
+  const halfB = { x: (place.width * r.zoom) / 2, y: (place.height * r.zoom) / 2 }
+  const dx = b.x - a.x
+  const dy = b.y - a.y
+  const horizontal = Math.abs(dx) - halfA.x - halfB.x >= Math.abs(dy) - halfA.y - halfB.y
+  if (horizontal) {
+    const sign = Math.sign(dx) || 1
+    canvas.drawLine(a.x + sign * halfA.x, a.y, b.x - sign * halfB.x, b.y, r.auxStroke)
+  } else {
+    const sign = Math.sign(dy) || 1
+    canvas.drawLine(a.x, a.y + sign * halfA.y, b.x, b.y - sign * halfB.y, r.auxStroke)
+  }
+  r.auxStroke.setPathEffect(null)
+}
+
+/**
+ * The quick-create dots off the sides of the selected block of a board, as FigJam shows them; the
+ * one under the pointer grows a plus and shows where its block would go.
+ */
+export function drawQuickCreateDots(
+  r: SkiaRenderer,
+  canvas: Canvas,
+  graph: SceneGraph,
+  quickCreate: RenderOverlays['quickCreate']
+) {
+  const node = quickCreate ? graph.getNode(quickCreate.nodeId) : undefined
+  if (!quickCreate || !node) return
+  if (quickCreate.hover) {
+    drawGhost(
+      r,
+      canvas,
+      getAxisAlignedWorldBounds(node, graph),
+      quickCreatePlace(graph, node, quickCreate.hover)
+    )
+  }
+  r.auxFill.setMaskFilter(null)
+  r.auxStroke.setPathEffect(null)
+  for (const dot of quickCreateDots(graph, node, r.zoom)) {
+    const at = toScreen(r, dot)
+    if (dot.side === quickCreate.hover) {
+      r.auxFill.setColor(r.selColor())
+      canvas.drawCircle(at.x, at.y, HOVERED_DOT_RADIUS, r.auxFill)
+      r.auxStroke.setStrokeWidth(2)
+      r.auxStroke.setColor(r.selForegroundColor())
+      canvas.drawLine(at.x - PLUS_ARM, at.y, at.x + PLUS_ARM, at.y, r.auxStroke)
+      canvas.drawLine(at.x, at.y - PLUS_ARM, at.x, at.y + PLUS_ARM, r.auxStroke)
+      continue
+    }
+    r.auxFill.setColor(r.ck.WHITE)
+    canvas.drawCircle(at.x, at.y, DOT_RADIUS, r.auxFill)
+    r.auxStroke.setStrokeWidth(1.5)
+    r.auxStroke.setColor(r.selColor())
+    canvas.drawCircle(at.x, at.y, DOT_RADIUS, r.auxStroke)
+  }
+}
